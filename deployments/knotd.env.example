# Node Main — copy to /etc/knot/knotd.env (chmod 600)
KNOT_HTTP_ADDR=0.0.0.0:443
KNOT_DB_PATH=/var/lib/knot/knot.db
KNOT_STATIC_DIR=/var/lib/knot/web
KNOT_TLS_CERT=/etc/knot/tls/fullchain.pem
KNOT_TLS_KEY=/etc/knot/tls/privkey.pem
KNOT_PUBLIC_BASE_URL=https://node.example.com
KNOT_BOOTSTRAP_ADMIN=you@example.com
KNOT_BOOTSTRAP_PASSWORD=change-me
